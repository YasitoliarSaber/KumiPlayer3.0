{
  "name": "tauri-shell",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "build:helper": "cargo build --release --manifest-path src/desktop-helper/Cargo.toml",
    "stage:helper": "node scripts/desktop/stage-helper.cjs",
    "build:desktop": "electron-vite build && npm run build:helper && npm run stage:helper",
    "dev:desktop": "electron-vite dev",
    "typecheck:desktop": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json && tsc -p tsconfig.renderer.json",
    "test:desktop": "vitest run tests/desktop",
    "verify:p01": "node scripts/desktop/p01-helper-orphan-check.cjs",
    "check:versions": "python scripts/check_versions.py",
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "test": "npm run test:contracts && npm run test:components",
    "test:components": "vitest run",
    "test:contracts": "node --test tests/*.test.ts",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.74.3",
    "@mantine/core": "^9.7.2",
    "@mantine/hooks": "^9.7.2",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-virtual": "^3.14.13",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@tauri-apps/cli": "^2.5.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^44.7.2",
    "electron-vite": "^6.0.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vitest": "^4.1.10"
  }
}
