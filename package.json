{
  "name": "tauri-shell",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "build:helper": "cargo build --release --manifest-path src/desktop-helper/Cargo.toml",
    "stage:helper": "node scripts/desktop/stage-helper.cjs",
    "build:desktop": "electron-vite build && npm run build:helper && npm run stage:helper",
    "dev:desktop": "electron-vite dev",
    "typecheck:desktop": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json && tsc -p tsconfig.renderer.json",
    "test:desktop": "vitest run tests/desktop",
    "verify:p01": "node scripts/desktop/p01-helper-orphan-check.cjs",
    "mock:assets": "node scripts/desktop/prepare-mock-assets.cjs",
    "dev:web:mock": "npm run mock:assets && vite --config vite.web.config.ts",
    "build:web:mock": "npm run mock:assets && vite build --config vite.web.config.ts",
    "preview:web:mock": "vite preview --config vite.web.config.ts",
    "build:desktop:js": "electron-vite build",
    "dev:desktop:mock": "node scripts/desktop/run-desktop.cjs dev",
    "start:desktop:mock": "node scripts/desktop/run-desktop.cjs run",
    "verify:desktop:mock": "node scripts/desktop/run-desktop.cjs verify",
    "check:versions": "python scripts/check_versions.py",
    "dev": "npm run dev:web:mock",
    "dev:legacy": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "test": "npm run test:contracts && npm run test:components",
    "test:components": "vitest run",
    "test:contracts": "node --test tests/*.test.ts",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.74.3",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-virtual": "^3.14.13",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.21.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.4.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@tauri-apps/cli": "^2.5.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^44.7.2",
    "electron-vite": "^6.0.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vitest": "^4.1.10"
  }
}
